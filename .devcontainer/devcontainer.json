{
  "name": "OpenMontage Drama Studio Preview",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "remoteUser": "vscode",
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": { "label": "OpenMontage Drama Studio", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bash .devcontainer/setup-preview.sh",
  "postStartCommand": "bash .devcontainer/start-preview.sh",
  "waitFor": "postStartCommand"
}
